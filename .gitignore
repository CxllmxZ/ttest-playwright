# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Playwright output
playwright-report/
test-results/
blob-report/
report/

# IDE
.vscode/*
.idea/
!.vscode/tasks.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local Playwright browsers
browsers/

# Secrets / environment
.env
.env.*
!.env.example

# Microsoft authentication
Authen/Microsoft/profile/*
Authen/Microsoft/state.json
!Authen/Microsoft/profile/.gitkeep

# Form login — saved session and the scratch file that may hold a pasted password
Test-Local/**/_login/session-storage.json
Test-Local/**/_login/state.json
Test-Local/**/_login/login-locators.ts

# AI Agent cache
.agent-cache/

# Private client projects — never publish
Test-Local/WEF/

# NOTE: committed on purpose
#   _flows/, _locators/      dev-owned sources (helper.ts imports _locators at runtime)
#   _scenarios/              QA-owned CSV test scenarios
#   _login/login.setup.ts    generated by Setup 2 — never contains credentials
#   .vscode/tasks.json       Setup 1 / 2 / 5 / 7 as VS Code Tasks
